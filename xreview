#!/usr/bin/env bash
set -euo pipefail

CLAUDE_BIN="${CLAUDE_BIN:-claude}"
CLAUDE_MODEL="${XREVIEW_CLAUDE_MODEL:-opus}"
CLAUDE_EFFORT="${XREVIEW_CLAUDE_EFFORT:-max}"
CLAUDE_DISALLOWED_TOOLS="Edit,Write,NotebookEdit,Bash(git add:*),Bash(git checkout:*),Bash(git clean:*),Bash(git commit:*),Bash(git push:*),Bash(git reset:*),Bash(git restore:*),Bash(git stash:*),Bash(git switch:*)"

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -h "$SCRIPT_PATH" ]]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
BUNDLED_SKILL_PATH="$SCRIPT_DIR/skills/xreview/SKILL.md"
GLOBAL_SKILL_PATH="$HOME/.agents/skills/xreview/SKILL.md"

mode="lite"
scope=""
pr=""
dry_run=0
headless=0
mechanical=0
declare -a passthrough=()

usage() {
  cat <<'EOF'
Usage: xreview [target|--staged|--working|--pr N] [options] [paths...]

Opens a fresh code-review session for a local commit, range, dirty/staged diff,
PR, or file scope. Default outside Codex: a visible `codex review` in a new
Terminal window. Default inside a Codex shell: Claude reviewer for cross-agent
checking. Use XREVIEW_ENGINE=codex or XREVIEW_ENGINE=claude to force either.

Options:
  --mode MODE       Review mode. Global modes: lite, mid, deep, security, docs.
                    Other modes are repo-specific and must be defined locally.
  --scope VALUE     Named scope or focus label.
  --pr VALUE        Review a GitHub PR number or URL with gh.
  --staged          Review staged changes.
  --working         Review unstaged working-tree changes.
  --mechanical      Produce a Mechanical Test Contract instead of a bug review.
  --test-contract   Alias for --mechanical.
  --tests           Alias for --mechanical.
  --headless        Run the review in-process (no window). Default spawns a
                    visible Terminal window for the selected reviewer.
  --dry-run         Print resolved launcher settings without starting the reviewer.
  -v, --version     Show the launcher version.
  -h, --help        Show this help.

Examples:
  xreview
  xreview HEAD
  xreview 709558d
  xreview HEAD~3..HEAD
  xreview --staged
  xreview --pr 123
  xreview HEAD --mechanical --mode lite

Output:
  Every run (windowed or --headless) is tee'd to a unique per-repo log with a
  completion marker containing the reviewer exit status:
    ${XREVIEW_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/xreview}/<repo>-<path-hash>-<run-id>.log
    <log-path>.done
  A <repo>-<path-hash>-latest.log symlink points at the newest run when the
  platform permits symlinks.

Claude defaults to Opus at max effort. Override with XREVIEW_CLAUDE_MODEL and
XREVIEW_CLAUDE_EFFORT. No API key is required when the selected CLI is already
authenticated through a subscription.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -v|--version)
      echo "xreview 2.0.0"
      exit 0
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --headless)
      headless=1
      shift
      ;;
    --mechanical|--test-contract|--tests)
      mechanical=1
      shift
      ;;
    --staged|--working)
      passthrough+=("$1")
      shift
      ;;
    --mode)
      if [[ $# -lt 2 || "$2" == --* ]]; then
        echo "xreview: --mode needs a value." >&2
        exit 2
      fi
      mode="$2"
      passthrough+=("$1" "$2")
      shift 2
      ;;
    --mode=*)
      mode="${1#--mode=}"
      if [[ -z "$mode" ]]; then
        echo "xreview: --mode needs a value." >&2
        exit 2
      fi
      passthrough+=("$1")
      shift
      ;;
    --scope)
      if [[ $# -lt 2 || "$2" == --* ]]; then
        echo "xreview: --scope needs a value." >&2
        exit 2
      fi
      scope="$2"
      passthrough+=("$1" "$2")
      shift 2
      ;;
    --scope=*)
      scope="${1#--scope=}"
      if [[ -z "$scope" ]]; then
        echo "xreview: --scope needs a value." >&2
        exit 2
      fi
      passthrough+=("$1")
      shift
      ;;
    --pr)
      if [[ $# -lt 2 || "$2" == --* ]]; then
        echo "xreview: --pr needs a value." >&2
        exit 2
      fi
      pr="$2"
      passthrough+=("$1" "$2")
      shift 2
      ;;
    --pr=*)
      pr="${1#--pr=}"
      if [[ -z "$pr" ]]; then
        echo "xreview: --pr needs a value." >&2
        exit 2
      fi
      passthrough+=("$1")
      shift
      ;;
    pr:*)
      pr="${1#pr:}"
      if [[ -z "$pr" ]]; then
        echo "xreview: pr: needs a value." >&2
        exit 2
      fi
      passthrough+=("$1")
      shift
      ;;
    --*)
      echo "xreview: unknown option '$1'." >&2
      exit 2
      ;;
    *)
      passthrough+=("$1")
      shift
      ;;
  esac
done

if ! [[ "$mode" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$ ]]; then
  echo "xreview: mode must be a 1-32 character name using letters, digits, dot, underscore, or dash." >&2
  exit 2
fi
if ! [[ "$CLAUDE_MODEL" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$ ]]; then
  echo "xreview: XREVIEW_CLAUDE_MODEL contains unsupported characters." >&2
  exit 2
fi
case "$CLAUDE_EFFORT" in
  low|medium|high|xhigh|max) ;;
  *)
    echo "xreview: XREVIEW_CLAUDE_EFFORT must be low, medium, high, xhigh, or max." >&2
    exit 2
    ;;
esac

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$repo_root" ]]; then
  echo "xreview: run from inside a git repository." >&2
  exit 1
fi

cd "$repo_root"

if [[ -n "${XREVIEW_SKILL_PATH:-}" ]]; then
  skill_path="$XREVIEW_SKILL_PATH"
elif [[ -f "$repo_root/.agents/skills/xreview/SKILL.md" ]]; then
  skill_path="$repo_root/.agents/skills/xreview/SKILL.md"
elif [[ -f "$repo_root/.claude/skills/xreview/SKILL.md" ]]; then
  skill_path="$repo_root/.claude/skills/xreview/SKILL.md"
elif [[ -f "$repo_root/.codex/skills/xreview/SKILL.md" ]]; then
  skill_path="$repo_root/.codex/skills/xreview/SKILL.md"
elif [[ -f "$BUNDLED_SKILL_PATH" ]]; then
  skill_path="$BUNDLED_SKILL_PATH"
else
  skill_path="$GLOBAL_SKILL_PATH"
fi

if [[ ! -f "$skill_path" ]]; then
  echo "xreview: skill not found at $skill_path" >&2
  exit 1
fi

join_shell_quoted() {
  local result=""
  local item
  local encoded
  for item in "$@"; do
    printf -v encoded '%q' "$item"
    result="${result}${result:+ }${encoded}"
  done
  printf '%s' "$result"
}

args_text="<none>"
if [[ -n "${passthrough[*]-}" ]]; then
  args_text="$(join_shell_quoted "${passthrough[@]}")"
fi
declare -a scope_args=()
for ((i = 0; i < ${#passthrough[@]}; i++)); do
  arg="${passthrough[$i]}"
  case "$arg" in
    --mode|--scope|--pr)
      i=$((i + 1))
      ;;
    --mode=*|--scope=*|--pr=*|pr:*)
      ;;
    *)
      scope_args+=("$arg")
      ;;
  esac
done

scope_text=""
if [[ -n "${scope_args[*]-}" ]]; then
  scope_text="$(join_shell_quoted "${scope_args[@]}")"
fi
if [[ -z "$scope_text" ]]; then
  if [[ -n "$(git status --porcelain)" ]]; then
    scope_text="dirty working tree"
  else
    scope_text="HEAD"
  fi
fi

if [[ -n "$pr" ]]; then
  scope_text="PR $(join_shell_quoted "$pr")"
fi

first_scope_arg="${scope_args[0]:-}"
scope_display="$(LC_ALL=C printf '%s' "$scope_text" | LC_ALL=C tr -cd '[:print:]')"
scope_title="$scope_display"
if [[ -n "$scope" ]]; then
  scope_title="checking $scope"
elif [[ -n "$pr" ]]; then
  scope_title="checking PR $pr"
elif [[ -z "${scope_args[*]:-}" ]]; then
  scope_title="checking $scope_text"
else
  case "$first_scope_arg" in
    --staged)
      scope_title="checking staged changes"
      ;;
    --working)
      scope_title="checking working tree"
      ;;
    *..*)
      scope_title="checking commits $first_scope_arg"
      ;;
    HEAD|head)
      scope_title="checking HEAD"
      ;;
    *)
      scope_title="checking $first_scope_arg"
      ;;
  esac
fi

engine_explicit=0
scope_needs_claude=0
scope_claude_reason=""

has_staged=0
has_working=0
scope_count=0
if [[ -n "${scope_args[*]-}" ]]; then
  scope_count=${#scope_args[@]}
  for arg in "${scope_args[@]}"; do
    [[ "$arg" == "--staged" ]] && has_staged=1
    [[ "$arg" == "--working" ]] && has_working=1
  done
fi
if [[ "$has_staged" -eq 1 && "$has_working" -eq 1 ]]; then
  echo "xreview: choose either --staged or --working, not both." >&2
  exit 2
fi

if [[ "$dry_run" -eq 0 && "$scope_count" -eq 1 ]]; then
  case "$first_scope_arg" in
    --staged)
      if git diff --cached --quiet; then
        echo "xreview: staged scope has no diff; nothing to review."
        exit 0
      fi
      ;;
    --working)
      if git diff --quiet; then
        echo "xreview: working scope has no diff; nothing to review."
        exit 0
      fi
      ;;
    *..*)
      if git diff --quiet "$first_scope_arg" 2>/dev/null; then
        echo "xreview: range $first_scope_arg has no diff; nothing to review."
        exit 0
      fi
      ;;
    *)
      if [[ -n "$first_scope_arg" && "$first_scope_arg" != --* ]] && \
          ! git rev-parse --verify --quiet "${first_scope_arg}^{commit}" >/dev/null 2>&1 && \
          git diff --quiet HEAD -- "$first_scope_arg" 2>/dev/null && \
          [[ -z "$(git ls-files --others --exclude-standard -- "$first_scope_arg")" ]]; then
        echo "xreview: path $scope_display has no diff; nothing to review."
        exit 0
      fi
      ;;
  esac
fi

if [[ "$mechanical" -eq 1 ]]; then
  scope_needs_claude=1
  scope_claude_reason="mechanical reviews use the Claude test-contract prompt"
elif [[ -n "$pr" ]]; then
  scope_needs_claude=1
  scope_claude_reason="pull-request review needs exact gh-based scope resolution"
elif [[ "$first_scope_arg" == "--staged" || "$first_scope_arg" == "--working" ]]; then
  scope_needs_claude=1
  scope_claude_reason="$first_scope_arg needs an exact diff rather than Codex's combined --uncommitted scope"
elif [[ "$scope_count" -gt 1 ]]; then
  scope_needs_claude=1
  scope_claude_reason="combined revision and path scopes need exact filtering"
elif [[ "$first_scope_arg" == *..* ]]; then
  scope_needs_claude=1
  scope_claude_reason="commit ranges need exact two-revision resolution"
elif [[ -n "$first_scope_arg" && "$first_scope_arg" != --* ]] && \
     ! git rev-parse --verify --quiet "${first_scope_arg}^{commit}" >/dev/null 2>&1; then
  scope_needs_claude=1
  scope_claude_reason="path-limited review is not exposed by codex review"
fi

if [[ -n "${XREVIEW_ENGINE:-}" ]]; then
  ENGINE="$XREVIEW_ENGINE"
  engine_explicit=1
elif [[ -n "${CODEX_SHELL:-}" || -n "${CODEX_THREAD_ID:-}" ]]; then
  ENGINE="claude"
elif [[ "$scope_needs_claude" -eq 1 ]]; then
  ENGINE="claude"
else
  ENGINE="codex"
fi

case "$ENGINE" in
  claude|codex) ;;
  *)
    echo "xreview: XREVIEW_ENGINE must be 'claude' or 'codex'." >&2
    exit 2
    ;;
esac

if [[ "$ENGINE" == "codex" && "$scope_needs_claude" -eq 1 ]]; then
  echo "xreview: this scope requires Claude: $scope_claude_reason." >&2
  echo "xreview: unset XREVIEW_ENGINE or use XREVIEW_ENGINE=claude." >&2
  exit 2
fi

if [[ -n "$pr" && "$dry_run" -eq 0 ]]; then
  if ! command -v gh >/dev/null 2>&1; then
    echo "xreview: --pr requires the GitHub CLI (gh)." >&2
    exit 127
  fi
  if ! gh auth status >/dev/null 2>&1; then
    echo "xreview: --pr requires an authenticated GitHub CLI; run 'gh auth login'." >&2
    exit 1
  fi
fi

# Codex sessions prefer Claude for an independent review, but a missing or
# logged-out Claude installation should not turn an ordinary review into a
# silent no-op. Fall back to the authenticated Codex reviewer unless the task
# is Claude-only (`--mechanical`) or the caller explicitly requires Claude.
if [[ "$ENGINE" == "claude" && "$dry_run" -eq 0 ]]; then
  claude_unavailable_reason=""
  if ! command -v "$CLAUDE_BIN" >/dev/null 2>&1; then
    claude_unavailable_reason="Claude binary not found"
  else
    claude_auth_status="$("$CLAUDE_BIN" auth status 2>/dev/null || true)"
    if ! grep -Eq '"loggedIn"[[:space:]]*:[[:space:]]*true' <<<"$claude_auth_status"; then
      claude_unavailable_reason="Claude is not logged in"
    fi
  fi

  if [[ -n "$claude_unavailable_reason" ]]; then
    if [[ "$mechanical" -eq 0 && "$engine_explicit" -eq 0 && "$scope_needs_claude" -eq 0 && \
          "${XREVIEW_REQUIRE_CLAUDE:-0}" != "1" ]] && command -v codex >/dev/null 2>&1; then
      echo "xreview: $claude_unavailable_reason; falling back to the Codex reviewer." >&2
      if [[ "$claude_unavailable_reason" == "Claude binary not found" ]]; then
        echo "xreview: install Claude Code to restore cross-agent reviews." >&2
      else
        echo "xreview: run 'claude auth login' to restore cross-agent reviews." >&2
      fi
      ENGINE="codex"
    else
      echo "xreview: $claude_unavailable_reason." >&2
      if [[ "$claude_unavailable_reason" == "Claude binary not found" ]]; then
        echo "xreview: install Claude Code before this Claude-only review." >&2
      else
        echo "xreview: run 'claude auth login' before this Claude-only review." >&2
      fi
      exit 1
    fi
  fi
fi

if [[ "$ENGINE" == "codex" && "$dry_run" -eq 0 ]] && ! command -v codex >/dev/null 2>&1; then
  echo "xreview: codex not found (set XREVIEW_ENGINE=claude for the Claude reviewer)." >&2
  exit 127
fi

if [[ "$mechanical" -eq 1 ]]; then
  review_kind="mechanical test reviewer"
else
  review_kind="reviewer"
fi

if [[ "$dry_run" -eq 1 ]]; then
  action="dry-run: would spawn terminal-backed ${ENGINE} ${review_kind}"
else
  action="spawning terminal-backed ${ENGINE} ${review_kind}"
fi

# Tee every review's output to a predictable log file so the result is easy to
# re-check after the window closes. Include a path hash so same-named checkouts
# do not overwrite each other.
repo_path_hash() {
  if command -v shasum >/dev/null 2>&1; then
    printf '%s' "$repo_root" | LC_ALL=C shasum -a 256 | cut -c1-10
  elif command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$repo_root" | LC_ALL=C sha256sum | cut -c1-10
  else
    printf '%s' "$repo_root" | cksum | awk '{print $1}'
  fi
}

log_dir="${XREVIEW_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/xreview}"
log_stem="$(basename "$repo_root")-$(repo_path_hash)"
run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
log_name="${log_stem}-${run_id}.log"
latest_name="${log_stem}-latest.log"
log_file="$log_dir/$log_name"
if [[ "$dry_run" -eq 0 ]]; then
  if ! { mkdir -p "$log_dir" && : > "$log_file"; } 2>/dev/null; then
    log_dir="${TMPDIR:-/tmp}/xreview"
    mkdir -p "$log_dir"
    log_file="$log_dir/$log_name"
    : > "$log_file"
    echo "xreview: configured log directory is not writable; using $log_dir." >&2
  fi
  latest_file="$log_dir/$latest_name"
  ln -sfn "$log_file" "$latest_file" 2>/dev/null || true
  done_file="${log_file}.done"
  rm -f "$done_file"
else
  latest_file="$log_dir/$latest_name"
  done_file="${log_file}.done"
fi

cat >&2 <<EOF
xreview: $action
repo: $repo_root
skill: $skill_path
scope: $scope_display
mode: $mode
mechanical: $mechanical
log: $log_file
done: $done_file
latest: $latest_file
EOF

if [[ "$ENGINE" == "claude" ]]; then
  cat >&2 <<EOF
model: $CLAUDE_MODEL
effort: $CLAUDE_EFFORT
EOF
fi

IFS= read -r -d '' codex_prompt <<EOF || true
Use the xreview skill at $skill_path.

Repository: $repo_root
Raw arguments: $args_text
Resolved scope: $scope_text
Mode: $mode
Scope label: ${scope:-<none>}

Run one fresh, read-only review. The Codex review command has already pinned the
Git scope. Read the skill and repository instructions, apply the requested mode
and scope label, inspect surrounding source for every finding, and report only
high-confidence actionable issues. Findings come first; include residual risk
or tests not run. Do not edit files or mutate Git state.
EOF

spawn_runner() {
  local runner_path="$1"
  case "$(uname -s)" in
    Darwin)
      if command -v osascript >/dev/null 2>&1 && \
          XREVIEW_RUNNER="$runner_path" osascript >/dev/null 2>&1 <<'APPLESCRIPT'
set runnerPath to system attribute "XREVIEW_RUNNER"
tell application "Terminal"
  activate
  do script "bash " & quoted form of runnerPath
end tell
APPLESCRIPT
      then
        return 0
      fi
      ;;
    Linux)
      if command -v gnome-terminal >/dev/null 2>&1; then
        gnome-terminal -- bash "$runner_path" &
      elif command -v konsole >/dev/null 2>&1; then
        konsole --new-tab -e bash "$runner_path" &
      elif command -v wezterm >/dev/null 2>&1; then
        wezterm start -- bash "$runner_path" &
      elif command -v kitty >/dev/null 2>&1; then
        kitty bash "$runner_path" &
      elif command -v xterm >/dev/null 2>&1; then
        xterm -e bash "$runner_path" &
      elif [[ -n "${TMUX:-}" ]] && command -v tmux >/dev/null 2>&1; then
        tmux new-window -n xreview bash "$runner_path"
      else
        return 1
      fi
      return 0
      ;;
    MINGW*|MSYS*|CYGWIN*)
      if command -v wt.exe >/dev/null 2>&1; then
        wt.exe new-tab bash "$runner_path" &
        return 0
      fi
      ;;
  esac
  return 1
}

# ---------------------------------------------------------------------------
# Engine dispatch. Default opens a VISIBLE Terminal window so the session can
# be watched live. `--headless` runs inline when the caller wants captured
# output instead of an external window.
# ---------------------------------------------------------------------------
if [[ "$ENGINE" == "codex" ]]; then
  # Map the resolved scope onto `codex review` flags.
  declare -a review_args=(review)
  first="${scope_args[0]:-}"
  if [[ -z "$first" ]]; then
    if [[ -n "$(git status --porcelain)" ]]; then
      review_args+=(--uncommitted)
    else
      review_args+=(--commit HEAD)
    fi
  else
    review_args+=(--commit "$first")
  fi

  if [[ "$dry_run" -eq 1 ]]; then
    echo "xreview: would run -> codex ${review_args[*]} <xreview-prompt>" >&2
    exit 0
  fi

  # --headless: run codex review in-process (no window) so the caller captures
  # the output. Default (no flag) spawns a visible Terminal window below.
  if [[ "$headless" -eq 1 ]]; then
    echo "xreview: running codex ${review_args[*]} headless (log: $log_file)." >&2
    set +e
    codex "${review_args[@]}" "$codex_prompt" 2>&1 | tee "$log_file"
    status="${PIPESTATUS[0]}"
    set -e
    printf '%s\n' "$status" > "$done_file"
    exit "$status"
  fi

  # A tiny runner avoids fragile AppleScript quoting for the cd + codex command.
  runner="$(mktemp "${TMPDIR:-/tmp}/xreview_codex.XXXXXX")"
  {
    printf '#!/usr/bin/env bash\n'
    printf 'status=1\n'
    printf 'mark_done() { printf "%%s\\n" "$status" > %q; }\n' "$done_file"
    printf 'trap mark_done EXIT\n'
    printf 'cd %q || exit 1\n' "$repo_root"
    printf 'printf "%%s\\n" %q\n' "== xreview (codex) | scope: $scope_display | mode: $mode =="
    printf 'codex'
    printf ' %q' "${review_args[@]}" "$codex_prompt"
    printf ' 2>&1 | tee %q\n' "$log_file"
    printf 'status=${PIPESTATUS[0]}\n'
    printf 'echo; echo "== codex review finished (exit $status). =="\n'
    printf 'printf "%%s\\n" %q\n' "xreview: full output saved to $log_file"
    printf 'rm -f %q\n' "$runner"
    printf 'exit "$status"\n'
  } > "$runner"
  chmod +x "$runner"

  if spawn_runner "$runner"; then
    echo "xreview: opened a terminal running 'codex ${review_args[*]}' (scope: $scope_display, mode: $mode)." >&2
    exit 0
  fi
  echo "xreview: no supported visible terminal found; running codex inline." >&2
  exec bash "$runner"
fi

if [[ "$dry_run" -eq 1 ]]; then
  exit 0
fi

if ! command -v "$CLAUDE_BIN" >/dev/null 2>&1; then
  echo "xreview: claude binary not found. Set CLAUDE_BIN or add claude to PATH." >&2
  exit 127
fi
CLAUDE_CMD="$(command -v "$CLAUDE_BIN")"

# NOTE: read the heredoc into a var instead of prompt="$(cat <<EOF ...)".
# macOS ships bash 3.2, which mis-parses heredocs nested in $() command
# substitution (apostrophes in the body trigger "unexpected EOF"). Slurping
# via `read -r -d ''` is a plain heredoc that bash 3.2 handles correctly.
if [[ "$mechanical" -eq 1 ]]; then
  IFS= read -r -d '' prompt <<EOF || true
Use the xreview skill at $skill_path.

Repository: $repo_root
Raw arguments: ${args_text:-<none>}
Resolved initial scope hint: $scope_text
Mode: $mode
Scope label: ${scope:-<none>}

Run the skill's read-only Mechanical Test Contract workflow in a fresh single
reviewer session. Resolve the exact target from the raw arguments, read project
instructions and the nearest test harnesses, and return the skill's prescribed
mechanical output. Do not edit files, run proof commands, or mutate Git state.
EOF
else
  IFS= read -r -d '' prompt <<EOF || true
Use the xreview skill at $skill_path.

Repository: $repo_root
Raw arguments: ${args_text:-<none>}
Resolved initial scope hint: $scope_text
Mode: $mode
Scope label: ${scope:-<none>}

Run the skill's read-only xreview workflow in a fresh single-reviewer session.
Resolve the exact target from the raw arguments, read project instructions,
inspect surrounding source, and return only high-confidence actionable
findings plus residual risk. Do not edit files or mutate Git state.
EOF
fi

if [[ "$headless" -eq 1 ]]; then
  if [[ "$mechanical" -eq 1 ]]; then
    echo "xreview: running claude mechanical test reviewer headless (log: $log_file)." >&2
  else
    echo "xreview: running claude reviewer headless (log: $log_file)." >&2
  fi
  set +e
  "$CLAUDE_CMD" -p --model "$CLAUDE_MODEL" --effort "$CLAUDE_EFFORT" \
    --disallowedTools "$CLAUDE_DISALLOWED_TOOLS" --permission-mode plan \
    "$prompt" 2>&1 | tee "$log_file"
  status="${PIPESTATUS[0]}"
  set -e
  printf '%s\n' "$status" > "$done_file"
  exit "$status"
fi

case "$mode" in
  lite|light)
    title_mode="LITE"
    title_color="#102C42"
    text_color="#E8F5FF"
    ;;
  mid)
    title_mode="MID"
    title_color="#12351E"
    text_color="#E6FFE9"
    ;;
  deep)
    title_mode="DEEP"
    title_color="#071735"
    text_color="#BDF8FF"
    ;;
  security)
    title_mode="SECURITY"
    title_color="#3A1115"
    text_color="#FFE8EA"
    ;;
  docs)
    title_mode="DOCS"
    title_color="#102C42"
    text_color="#E8F5FF"
    ;;
  *)
    title_mode="$(printf '%s' "$mode" | tr '[:lower:]' '[:upper:]')"
    title_color="#252525"
    text_color="#F0F0F0"
    ;;
esac

scope_title="$(LC_ALL=C printf '%s' "$scope_title" | LC_ALL=C tr -cd '[:print:]')"
if [[ ${#scope_title} -gt 56 ]]; then
  scope_title="${scope_title:0:53}..."
fi
if [[ "$mechanical" -eq 1 ]]; then
  window_title="Claude mechanical ${title_mode}: ${scope_title}"
else
  window_title="Claude xreview ${title_mode}: ${scope_title}"
fi

prompt_file="$(mktemp "${TMPDIR:-/tmp}/xreview_claude_prompt.XXXXXX")"
runner="$(mktemp "${TMPDIR:-/tmp}/xreview_claude.XXXXXX")"
printf '%s' "$prompt" > "$prompt_file"
{
  printf '#!/usr/bin/env bash\n'
  printf 'set -euo pipefail\n'
  printf 'status=1\n'
  printf 'mark_done() { printf "%%s\\n" "$status" > %q; }\n' "$done_file"
  printf 'trap mark_done EXIT\n'
  printf 'cd %q || exit 1\n' "$repo_root"
  printf 'printf "\\033]0;%%s\\007" %q\n' "$window_title"
  printf 'printf "\\033]10;%%s\\007" %q\n' "$text_color"
  printf 'printf "\\033]11;%%s\\007" %q\n' "$title_color"
  if [[ "$mechanical" -eq 1 ]]; then
    printf 'printf "%%s\\n" %q\n' "== mechanical test review (claude) | mode: $mode | scope: $scope_display =="
  else
    printf 'printf "%%s\\n" %q\n' "== xreview (claude) | mode: $mode | scope: $scope_display =="
  fi
  printf 'echo "xreview: claude -p is running; this window may stay quiet until the final report."\n'
  printf 'echo "xreview: heartbeat every 30s so a slow review does not look dead."\n'
  printf 'prompt="$(cat %q)"\n' "$prompt_file"
  printf '(\n'
  if [[ "$mechanical" -eq 1 ]]; then
    printf '  while true; do sleep 30; echo "xreview: still waiting for claude mechanical test reviewer... ($(date +%%H:%%M:%%S))"; done\n'
  else
    printf '  while true; do sleep 30; echo "xreview: still waiting for claude reviewer... ($(date +%%H:%%M:%%S))"; done\n'
  fi
  printf ') &\n'
  printf 'heartbeat_pid=$!\n'
  printf 'cleanup_heartbeat() { kill "$heartbeat_pid" 2>/dev/null || true; wait "$heartbeat_pid" 2>/dev/null || true; }\n'
  printf 'trap "cleanup_heartbeat; mark_done" EXIT\n'
  printf 'set +e\n'
  printf '%q -p --model %q --effort %q --disallowedTools %q --permission-mode plan "$prompt" 2>&1 | tee %q\n' "$CLAUDE_CMD" "$CLAUDE_MODEL" "$CLAUDE_EFFORT" "$CLAUDE_DISALLOWED_TOOLS" "$log_file"
  printf 'status=${PIPESTATUS[0]}\n'
  printf 'set -e\n'
  printf 'cleanup_heartbeat\n'
  if [[ "$mechanical" -eq 1 ]]; then
    printf 'echo; echo "== claude mechanical test review finished (exit $status). =="\n'
  else
    printf 'echo; echo "== claude xreview finished (exit $status). =="\n'
  fi
  printf 'printf "%%s\\n" %q\n' "xreview: full output saved to $log_file"
  printf 'rm -f %q %q\n' "$prompt_file" "$runner"
  printf 'exit "$status"\n'
} > "$runner"
chmod +x "$runner"

if spawn_runner "$runner"; then
  if [[ "$mechanical" -eq 1 ]]; then
    echo "xreview: opened a terminal running claude mechanical test reviewer (scope: $scope_display, mode: $mode)." >&2
  else
    echo "xreview: opened a terminal running claude reviewer (scope: $scope_display, mode: $mode)." >&2
  fi
  exit 0
fi

echo "xreview: no supported visible terminal found; running claude inline." >&2

exec bash "$runner"
